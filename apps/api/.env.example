# Environment Variables
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (include connection_limit and pool_timeout in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clock_in?schema=public&connection_limit=20&pool_timeout=20"

# Comma-separated allowed frontend origins (wildcard * is rejected in production)
CORS_ORIGIN=http://localhost:3000

# JWT Secrets (minimum 32 random characters each in production)
JWT_ACCESS_SECRET=supersecretaccesskey_min_32_characters_long_12345
JWT_REFRESH_SECRET=supersecretrefreshkey_min_32_characters_long_12345

# Workspace Defaults (can also be managed via Super Admin settings)
WORKSPACE_TIMEZONE=Africa/Lagos
WORKSPACE_NAME="Dare Adeboye Innovation Hub"

# Optional SMTP configuration for Email 2FA verification codes
# Leave blank in local development to preview codes in the console / UI
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dare Adeboye Innovation Hub <no-reply@clockin.workspace>"
